# Every upstream this build consumes, pinned to an exact commit (resolved 2026-11-16; all but Nova/SUSFS/AnyKernel3/NoMount re-resolved to upstream tips 2026-11-25).
# Nothing is fetched from a moving branch at build time. To update: change the sha, run the
# "dry-run" stage of the workflow first, then a full build.

# ---- source: Google kernel/common, the exact tree the phone's stock kernel was built from -------------
# uname -r on the phone:  6.12.69-android16-6-g242e1a07f878-ab15865446-4k
COMMON_MANIFEST_BRANCH=common-android16-6.12-2026-03
COMMON_TAG=android16-6.12-2026-03_r54
COMMON_COMMIT_PREFIX=242e1a07f878
# stock vermagic of the phone's vendor modules (must match the built kernel byte for byte)
STOCK_RELEASE=6.12.69-android16-6-g242e1a07f878-ab15865446-4k

# ---- root: SukiSU Nova, in-tree "builtin-new" line (SUSFS glue + KPM inside the driver) -----------------
NOVA_REPO=https://github.com/SukiSU-Nova/SukiSU-Nova.git
NOVA_PIN=5a3ec4145059ed2c4f22c70a16a28a616e104c33

# ---- SUSFS kernel side (susfs4ksu, gki-android16-6.12 tip) --------------------------------------------
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_PIN=9b0b13f069673b9b07b713a5c66977de4d62b175

# ---- NoMount (maxsteeel/nomount, tag v2.3.1) --------------------------------------------------------------
NOMOUNT_REPO=https://github.com/maxsteeel/nomount.git
NOMOUNT_PIN=dcd77d03e9912f397a586d7da81694d1628f170e

# ---- Baseband Guard (vc-teahouse/Baseband-guard, main tip) --------------------------------------------
BBG_REPO=https://github.com/vc-teahouse/Baseband-guard.git
BBG_PIN=48d9fdea643bcb41d204541400e9d8656b97a54f

# ---- WildKernels patch collection (NTSync, Unicode fix, tuning patches) -------------------------------
WILD_PATCHES_REPO=https://github.com/WildKernels/kernel_patches.git
WILD_PATCHES_PIN=70c394f16d82b0f85a4f07617630d82dde6d203c

# ---- WildKernels GKI build repo: only its SUSFS porting helper scripts are used -----------------------
WILD_GKI_REPO=https://github.com/WildKernels/GKI_KernelSU_SUSFS.git
WILD_GKI_PIN=54d549fd398a2ccf2146785ab9b3e7b8a6808936

# ---- AnyKernel3 flasher (WildKernels fork, gki-2.0: arm64 busybox/magiskboot; osm0sis ships 32-bit tools that a 64-bit-only phone cannot run)
ANYKERNEL_REPO=https://github.com/WildKernels/AnyKernel3.git
ANYKERNEL_PIN=e1e9dce98430c5c6f231f7094a8c7f4ecaf50948
